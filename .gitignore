# Ergane's runtime root: worktrees, session transcripts, verification evidence.
# Never commit it; it lands megabytes of agent output on a branch.
.ergane/
# Legacy runtime root — `resolve_factory_root` can fall back to a relative
# `.factory` against the worker's cwd; keep it out of the tree if that ever fires.
.factory/

# Backend (uv / pytest)
.venv/
__pycache__/
*.pyc
.pytest_cache/
# What the `test` gate measures about itself (015 US1). Both land at the
# repository root because that is the declared, stable path PR-3's collector
# will read them from — and both are build products of a single run, not
# committed facts. A committed coverage.xml would be whatever the last person
# to run the suite happened to have, which is exactly the "green means two
# different things" failure 009 spent a story closing.
.coverage
.coverage.*
coverage.xml

# Frontend (npm / Vite / Playwright)
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
# What the `unit` gate measures about itself (015 US2), at the path
# `web/vitest.config.ts` declares. A build product of a single run, exactly as
# the backend's `coverage.xml` is: committing it would commit whatever the last
# person to run the suite happened to have.
web/coverage/
# Vitest's run cache. It lands wherever vitest was invoked from, which is the
# repository root when the runner is reached as `npx --prefix web vitest`
# rather than through `npm --prefix web run test:unit`.
.vite/
web/.vite/

# The pane's own delivery store (PANE_ATTENTION_DB): what the factory delivered
# to this host, never part of the repository.
.pane/

# Machine-local
.env
.env.*

# An operator's `ergane spec derive -o specs/<dir>/workgraph.json` output (017
# FR-006). The factory writes nothing at that path -- the roadmap compiles its
# graph in-process and never writes it back -- so the only file that ever
# appears there is a hand-derive, and three of them sat untracked for a day
# before anyone noticed. The graph the pane is meant to read is the archived,
# reviewed one under `docs/dags/`, which stays committed. Ignoring the path is
# what stops the accumulation; nothing here removes a file already on disk.
specs/*/workgraph.json

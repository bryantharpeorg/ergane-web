    { "path": "/desk", "kind": "room", "name": "The Desk" },
    { "path": "/showfloor", "kind": "room", "name": "The Showfloor" },
    { "path": "/review", "kind": "room", "name": "The review room" },
    { "path": "/draft", "kind": "room", "name": "The drafting table" },
    { "path": "/api/floor", "kind": "api", "name": "The floor document" },
    { "path": "/api/showfloor", "kind": "api", "name": "The showfloor document" },
    { "path": "/api/attention", "kind": "api", "name": "The attention list" },

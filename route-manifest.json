    },
    {
      "pattern": "pane/config.py",
      "routes": ["/", "/desk", "/showfloor", "/review", "/draft", "/api/floor", "/api/showfloor", "/api/attention", "/api/events", "/api/review/{spec_dir}", "/api/draft/{spec_dir}", "/api/attention/{correlation_id}/answer", "/intake/{credential:path}", "/{path:path}"]
    },

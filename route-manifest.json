    { "path": "/api/attention/{correlation_id}/answer", "kind": "api", "name": "Answer, the one verb" },
    { "path": "/intake/{credential:path}", "kind": "api", "name": "The factory's webhook intake" },
    { "path": "/{path:path}", "kind": "shell", "name": "The guarded app shell, which serves every room" }
